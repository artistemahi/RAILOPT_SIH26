            ? "Medium"
            : "Moderate",
      planningImplication:
        task.priority === "P1" ? "Reschedule Needed" : "Window Available",
    } satisfies RiskDetails;
  }, [data, selectedAssetId]);

  if (!data) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-slate-100 text-slate-600">
        Loading risk data...
      </div>
