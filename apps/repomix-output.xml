                <RiskTable
                  tasks={data.tasks}
                  selectedId={selectedAssetId}
                  onSelect={setSelectedAssetId}
                />
              </div>
            </div>

            <div>
              {selectedTask ? (
                <RiskDetailsPanel details={selectedTask} />
              ) : (
                <div className="rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-500">
