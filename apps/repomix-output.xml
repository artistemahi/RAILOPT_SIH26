import { useState, type FormEvent } from "react";
import { icons } from "./ui";
import {
  Analytics,
  Blocks,
  Compatibility,
  Integration,
  Optimizer,
  Overview,
  Planning,
  Quality,
  Replanning,
  Schedule,
  Settings,
  Tasks,
  Validation,
} from "./screens";
import { runMeta } from "./ops-data";

type View =
  | "overview"
  | "planning"
  | "tasks"
  | "blocks"
  | "compatibility"
  | "optimizer"
  | "schedule"
  | "analytics"
  | "replanning"
  | "validation"
  | "integration"
  | "quality"
  | "settings";

const primary: { id: View; label: string }[] = [
  { id: "overview", label: "Overview" },
  { id: "planning", label: "Planning" },
  { id: "tasks", label: "Tasks" },
  { id: "blocks", label: "Blocks" },
  { id: "compatibility", label: "Compatibility" },
  { id: "optimizer", label: "Optimizer" },
  { id: "schedule", label: "Schedule" },
  { id: "analytics", label: "Analytics" },
  { id: "replanning", label: "Replanning" },
  { id: "validation", label: "Validation" },
];

const secondary: { id: View; label: string }[] = [
  { id: "integration", label: "Data integration" },
  { id: "quality", label: "Data quality" },
  { id: "settings", label: "Settings" },
];

function Login({ onIn }: { onIn: () => void }) {
  const [err, setErr] = useState("");
  function submit(e: FormEvent) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const user = (form.elements.namedItem("user") as HTMLInputElement).value.trim();
    const pass = (form.elements.namedItem("pass") as HTMLInputElement).value.trim();
    if (!user || !pass) {
      setErr("Enter control-room credentials to continue.");
      return;
    }
    onIn();
  }
  return (
    <div className="login">
      <div className="login-hero">
        <div className="catenary" />
        <div className="login-copy">
          <small>Ministry of Railways · SIH 26027</small>
          <h2>Intelligent maintenance block planning</h2>
          <p>One corridor picture for Engineering, TRD and S&T — so possessions protect train paths instead of fighting them.</p>
        </div>
      </div>
      <div className="login-panel">
        <form className="login-card" onSubmit={submit}>
          <div className="mark">R</div>
          <h1>RailOpt AI</h1>
          <p className="sub">Safe rails · higher availability · smarter decisions</p>
          <label htmlFor="user">Username</label>
          <input id="user" name="user" autoComplete="username" placeholder="sr.dom.pryj" defaultValue="admin" />
          <label htmlFor="pass">Password</label>
          <input id="pass" name="pass" type="password" autoComplete="current-password" placeholder="••••••••" defaultValue="railopt" />
          <div className="row">
            <span>Demo: admin / railopt</span>
            <a href="#forgot">Forgot password?</a>
          </div>
          {err && <p className="mini-note" style={{ color: "#ff8a96", marginBottom: 8 }}>{err}</p>}
          <button className="login-go" type="submit">Sign in</button>
          <div className="login-foot">
            <span>Northern Railway</span>
            <span>v1.0 · SIH26027</span>
          </div>
        </form>
      </div>
    </div>
  );
}

export default function App() {
  const [authed, setAuthed] = useState(false);
  const [view, setView] = useState<View>("overview");
  const [notice, setNotice] = useState("");
  const [optDone, setOptDone] = useState(false);
  const [replanDone, setReplanDone] = useState(false);

  if (!authed) return <Login onIn={() => setAuthed(true)} />;

  const page =
    view === "overview" ? <Overview go={(v) => setView(v as View)} /> :
    view === "planning" ? (
      <Planning
        onGenerate={() => {
          setNotice("Planning run RP-2026-091 created — solver is primed.");
          setView("optimizer");
        }}
      />
    ) :
    view === "tasks" ? <Tasks /> :
    view === "blocks" ? <Blocks /> :
    view === "compatibility" ? <Compatibility /> :
    view === "optimizer" ? <Optimizer done={optDone} run={() => { setOptDone(true); setNotice("Feasible pack in 2.84s · 382 tasks, 0 hard conflicts."); }} /> :
    view === "schedule" ? <Schedule /> :
    view === "replanning" ? <Replanning done={replanDone} run={() => { setReplanDone(true); setNotice("Defect A37 inserted. Seven tasks retimed, passenger paths held."); }} /> :
    view === "validation" ? <Validation /> :
    view === "analytics" ? <Analytics /> :
    view === "integration" ? <Integration /> :
    view === "quality" ? <Quality /> :
    <Settings />;

  return (
    <div className="shell">
      <aside className="side">
        <div className="brand">
          <i>R</i>
          <div>
            <b>RailOpt AI</b>
            <small>Block planning · Indian Railways</small>
          </div>
        </div>
        <nav className="nav">
          {primary.map((n) => (
            <button key={n.id} className={view === n.id ? "on" : ""} onClick={() => { setView(n.id); setNotice(""); }}>
              {icons[n.id]}
              <span>{n.label}</span>
            </button>
          ))}
        </nav>
        <div className="nav-label">Platform</div>
        <nav className="nav">
          {secondary.map((n) => (
            <button key={n.id} className={view === n.id ? "on" : ""} onClick={() => { setView(n.id); setNotice(""); }}>
              {icons[n.id]}
              <span>{n.label}</span>
            </button>
          ))}
        </nav>
        <div className="side-user">
          <i className="dot" />
          <div>
            <span>Admin · Sr. DOM</span>
            <small>admin@railopt.in</small>
          </div>
        </div>
      </aside>
      <div className="work">
        <header className="top">
          <div className="search">Search tasks, blocks, trains, windows…</div>
          <span className="pill">Run <b>{runMeta.id}</b></span>
          <span className="pill">{runMeta.clock}</span>
          <div className="admin">
            <ChipAdmin />
          </div>
        </header>
        {notice && <div className="toast">✓ {notice}</div>}
        {page}
      </div>
    </div>
  );
}

function ChipAdmin() {
  return (
    <>
      <span className="pill">Allahabad Dn</span>
      <span>Admin ▾</span>
    </>
  );
}
