    summary: any[];
    tasks: RiskTask[];
  } | null>(null);
  const [selectedAssetId, setSelectedAssetId] = useState("A104");

  useEffect(() => {
    void getRiskData().then(setData);
  }, []);

  const selectedTask = useMemo(() => {
    const task =
      data?.tasks.find((item) => item.assetId === selectedAssetId) ??
      data?.tasks[0];
