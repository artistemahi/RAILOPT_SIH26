.grid-2 { display: grid; grid-template-columns: 1.2fr .8fr; gap: 10px; }
.grid-3 { display: grid; grid-template-columns: 1.1fr 1fr .9fr; gap: 10px; }
.grid-13 { display: grid; grid-template-columns: 1.4fr .9fr; gap: 10px; }
.grid-31 { display: grid; grid-template-columns: 1.6fr 1fr; gap: 10px; }
.stack { display: grid; gap: 10px; }

.chip {
  display: inline-flex; align-items: center; gap: 4px;
  border-radius: 999px; padding: 2px 8px; font-size: 10.5px; font-weight: 700;
}
.chip.ok { background: #e3f7ee; color: #0b7a56; }
.chip.warn { background: #fff4dc; color: #9a6208; }
.chip.crit, .chip.critical { background: #fde8ea; color: #b51d32; }
.chip.high { background: #ffeedd; color: #b85d00; }
.chip.medium { background: #fff6d4; color: #8d6a00; }
.chip.low { background: #e7f2fb; color: #14609a; }
.chip.info { background: #e7f2fb; color: #14609a; }
.chip.neutral { background: #eef3f7; color: #45627c; }
.chip.planned, .chip.available, .chip.loaded { background: #e3f7ee; color: #0b7a56; }
.chip.pending, .chip.watch, .chip.hold { background: #fff4dc; color: #9a6208; }
.chip.restricted, .chip.used { background: #fde8ea; color: #b51d32; }

.tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
.tbl th { text-align: left; font-size: 10.5px; letter-spacing: .04em; text-transform: uppercase; color: #5d758c; padding: 8px 10px; background: #f4f9fc; }
.tbl td { padding: 8px 10px; border-top: 1px solid #e7f0f6; }
.tbl tr.on td { background: #eef6ff; }
.tbl tbody tr { cursor: pointer; }
.tbl tbody tr:hover td { background: #f7fbfe; }
.id { font-family: "IBM Plex Mono", monospace; font-weight: 600; color: #0a4f9c; }

.legend { display: grid; gap: 6px; font-size: 12px; color: #3e5b74; }
.legend b { float: right; font-variant-numeric: tabular-nums; }
.sw { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }

.bars { display: grid; gap: 10px; align-content: end; min-height: 150px; }
.bar-row { display: grid; grid-template-columns: 78px 1fr 36px; gap: 8px; align-items: center; font-size: 12px; color: #3e5b74; }
.track { height: 9px; background: #e6eef4; border-radius: 99px; overflow: hidden; }
.track i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, #1a8cec, #0a5db5); }
.track i.g { background: linear-gradient(90deg, #1ec89a, #0b9a72); }
.track i.a { background: linear-gradient(90deg, #f0b429, #c67a0a); }

.donut-wrap { display: flex; align-items: center; justify-content: space-around; gap: 8px; min-height: 160px; }
.donut { position: relative; width: 132px; height: 132px; }
.donut svg { transform: rotate(-90deg); }
.donut .fig { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
.donut strong { font-size: 22px; display: block; line-height: 1; }
.donut small { color: var(--muted); }

.alerts { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; }
.alert-row { display: flex; gap: 10px; padding: 8px 0; border-bottom: 1px solid #eef4f8; font-size: 12.5px; align-items: start; }
.alert-row:last-child { border: 0; }
.flag { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex: none; }
.flag.crit { background: var(--crit); }
.flag.warn { background: var(--warn); }
.flag.info { background: var(--blue); }
.flag.ok { background: var(--ok); }

.corridor {
  display: flex; align-items: center; gap: 0; padding: 18px 8px 8px;
}
.st { flex: 1; text-align: center; position: relative; }
.st:not(:last-child):after {
  content: ""; position: absolute; top: 11px; left: 55%; right: -45%;
  height: 3px; background: repeating-linear-gradient(90deg, #0ea37a 0 10px, #0ea37a00 10px 14px);
}
.st i {
  width: 14px; height: 14px; border-radius: 50%; display: inline-block;
  border: 2px solid #0b6fd4; background: white; position: relative; z-index: 1;
}
.st.clear i { background: #19c98a; border-color: #0b9a72; }
.st.busy i { background: #f0b429; border-color: #c67a0a; }
.st.block i { background: #0b6fd4; border-color: #083e7a; box-shadow: 0 0 0 4px #0b6fd433; }
.st.watch i { background: #e23b4b; border-color: #b51d32; }
.st b { display: block; font-size: 11px; margin-top: 8px; }
.st small { color: var(--muted); font-size: 10px; }

.feed { font-size: 12px; }
.feed p { display: grid; grid-template-columns: 44px 48px 1fr; gap: 8px; padding: 7px 0; border-bottom: 1px dashed #d9e6ef; }
.feed time, .feed em { font-style: normal; color: #7b93a8; font-family: "IBM Plex Mono", monospace; font-size: 11px; }

.checks { display: flex; flex-wrap: wrap; gap: 8px; }
.tog {
  display: flex; align-items: center; gap: 6px;
  border: 1px solid var(--line); border-radius: 999px; padding: 6px 10px; background: #f7fbfe;
  font-size: 12px; font-weight: 600;
}
.tog input { accent-color: var(--blue); }
.form { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.form label, .field { font-size: 11px; font-weight: 600; color: #4a6882; display: block; }
.form input, .field input, .filters select, .filters input {
  display: block; width: 100%; margin-top: 4px;
  border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; background: #fbfdff;
}
.filters { display: flex; gap: 8px; padding: 10px 12px 0; }
.filters input { flex: 1; margin: 0; }
.filters select { width: 140px; margin: 0; }

.btn {
  border: 0; border-radius: 8px; padding: 9px 16px; font-weight: 700; color: white;
  background: linear-gradient(180deg, #1a8cec, #0a5db5);
}
.btn:hover { filter: brightness(1.05); }
.btn.full { width: 100%; margin-top: 8px; }
.btn.ghost { background: white; color: #0a5db5; border: 1px solid #b7d4ec; }
.btn.danger { background: linear-gradient(180deg, #ef5464, #c81e36); }
.btn.ok { background: linear-gradient(180deg, #1ec89a, #0b9a72); }

.src p { display: flex; justify-content: space-between; gap: 8px; padding: 8px 0; border-bottom: 1px solid #eef4f8; font-size: 12.5px; }
.src small { color: var(--muted); display: block; font-weight: 400; }

.detail-grid { display: grid; grid-template-columns: 1.05fr .95fr .9fr; gap: 10px; }
.kv { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; font-size: 12.5px; }
.kv dt { color: var(--muted); font-size: 11px; }
.kv dd { margin: 0; font-weight: 700; }
.win { display: grid; grid-template-columns: 52px 1fr auto; gap: 8px; align-items: center; padding: 6px 0; font-size: 12px; }

.matrix { width: 100%; border-collapse: separate; border-spacing: 6px; text-align: center; }
.matrix th { font-size: 11px; color: #4a6882; }
.matrix td {
  width: 64px; height: 52px; border-radius: 10px; font-size: 18px; font-weight: 700;
  vertical-align: middle;
}
.matrix td.ok { background: #dff6ea; color: #0b9a72; }
.matrix td.no { background: #fde4e7; color: #d3253c; }
.matrix td.maybe { background: #fff4d6; color: #c67a0a; }
.matrix td.self { background: #edf2f6; color: #8aa0b3; }
.reasons { list-style: none; padding: 0; margin: 0; display: grid; gap: 7px; font-size: 12.5px; }
.reasons li { display: flex; gap: 8px; }
.reasons .y { color: var(--ok); font-weight: 700; }
.reasons .n { color: var(--crit); font-weight: 700; }
.callout { margin-top: 12px; padding: 10px 12px; border-radius: 10px; background: #e8f5ff; border: 1px solid #c5e2f6; font-size: 12.5px; }

.gantt { font-size: 12px; }
.gantt-head, .gantt-row {
  display: grid; grid-template-columns: 110px 1fr; align-items: center;
}
.gantt-head { padding: 8px 10px; background: #f3f8fc; font-weight: 700; font-size: 11px; color: #4a6882; }
.gantt-head span { display: flex; justify-content: space-between; font-weight: 500; }
.gantt-row { border-top: 1px solid #e7f0f6; min-height: 42px; }
.gantt-row label { padding: 0 10px; font-size: 11px; color: #35587a; }
.lane {
  position: relative; height: 42px;
  background: repeating-linear-gradient(90deg, transparent 0 14.2%, #eaf1f6 14.2% 14.45%);
}
.blk {
  position: absolute; top: 10px; height: 22px; border-radius: 6px; color: white;
  font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 6px #0002;
}
.blk.eng { background: linear-gradient(180deg, #2b93ee, #0b6fd4); }
.blk.snt { background: linear-gradient(180deg, #2dcaa3, #0b9a72); }
.blk.trd { background: linear-gradient(180deg, #f0b429, #c67a0a); }
.trains { position: relative; height: 28px; margin: 6px 0 0 110px; }
.trains i {
  position: absolute; top: 6px; transform: translateX(-50%);
  font-style: normal; font-size: 10px; color: #35587a;
}
.trains i:before { content: "◆"; color: #0b6fd4; margin-right: 3px; }

.log { list-style: none; padding: 0; margin: 0; font-size: 12.5px; }
.log li { display: grid; grid-template-columns: 64px 1fr; gap: 8px; padding: 7px 0; border-bottom: 1px dashed #d9e6ef; }
.log time { font-family: "IBM Plex Mono", monospace; color: #7b93a8; font-size: 11px; }
.stamp {
  min-height: 220px; display: grid; place-content: center; text-align: center; gap: 6px;
  background:
    radial-gradient(circle at 50% 40%, #e9fbf3, transparent 60%),
    repeating-linear-gradient(-18deg, #f4fbf7 0 8px, #eef8f3 8px 16px);
}
.stamp b { font-size: 22px; color: #0b9a72; letter-spacing: .08em; }
.stamp .ring {
  width: 86px; height: 86px; margin: 0 auto 8px; border-radius: 50%;
  border: 6px solid #0b9a72; color: #0b9a72; display: grid; place-items: center; font-size: 36px;
}

.pipe { display: flex; align-items: stretch; gap: 8px; flex-wrap: wrap; }
.node {
  flex: 1; min-width: 90px; text-align: center; padding: 12px 8px;
  border: 1px solid var(--line); border-radius: 10px; background: #f7fbfe; font-weight: 700; font-size: 12px;
}
.node span { display: block; font-size: 10px; color: var(--ok); font-weight: 600; margin-top: 4px; }
.node.big { background: linear-gradient(180deg, #eef7ff, #e4f0fa); min-width: 140px; }
.arrow { align-self: center; color: #8aa0b3; font-size: 18px; }

.heat { display: grid; grid-template-columns: 72px repeat(7, 1fr); gap: 4px; font-size: 10px; color: #4a6882; }
.heat i { display: block; height: 28px; border-radius: 4px; background: #d3eaf7; }
.heat i.h1 { background: #cfe6f6; }
.heat i.h2 { background: #9fd0ef; }
.heat i.h3 { background: #5eafdf; }
.heat i.h4 { background: #2b8fd0; }
.heat i.h5 { background: #0b6fd4; }
.heat i.h6 { background: #084e96; }

.compare { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.compare th, .compare td { padding: 8px 10px; border-bottom: 1px solid #e7f0f6; text-align: left; }
.compare .gain { color: var(--ok); font-weight: 700; }

.quality { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
.quality p { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #eef4f8; }

.cols { display: flex; align-items: end; justify-content: space-around; height: 140px; gap: 10px; padding: 8px 8px 0; }
.col { width: 42px; border-radius: 6px 6px 0 0; background: linear-gradient(180deg, #3aa4f0, #0b6fd4); position: relative; }
.col span { position: absolute; top: -18px; left: 50%; transform: translateX(-50%); font-size: 10px; font-weight: 700; color: #35587a; }

.mini-note { font-size: 11.5px; color: var(--muted); line-height: 1.5; }

@media (max-width: 1100px) {
  .kpis, .grid-3, .detail-grid, .alerts { grid-template-columns: 1fr 1fr; }
  .grid-2, .grid-13, .grid-31 { grid-template-columns: 1fr; }
}
@media (max-width: 860px) {
  .login { grid-template-columns: 1fr; }
  .login-hero { min-height: 220px; }
  .side { width: 64px; }
  .brand b, .brand small, .nav button span, .side-user span, .nav-label { display: none; }
  .nav button { justify-content: center; }
  .kpis, .grid-3, .detail-grid, .alerts, .quality { grid-template-columns: 1fr; }
}
